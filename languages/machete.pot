#: inc/cleanup/i18n.php:13
msgid "Optimization"
msgstr ""

#: inc/cleanup/i18n.php:15
msgid "Reduces much of the legacy code bloat in WordPress page headers. It also has some tweaks to make your site faster and safer."
msgstr ""

#: inc/cleanup/i18n.php:19
msgid "RSD"
msgstr ""

#: inc/cleanup/i18n.php:20
msgid "Remove Really Simple Discovery (RSD) links. They are used for automatic pingbacks."
msgstr ""

#: inc/cleanup/i18n.php:23
msgid "WLW"
msgstr ""

#: inc/cleanup/i18n.php:24
msgid "Remove the link to wlwmanifest.xml. It is needed to support Windows Live Writer. Yes, seriously."
msgstr ""

#: inc/cleanup/i18n.php:27
msgid "feed_links"
msgstr ""

#: inc/cleanup/i18n.php:28
msgid "Remove Automatics RSS links. RSS will still work, but you will need to provide your own links."
msgstr ""

#: inc/cleanup/i18n.php:31
msgid "feed_generator"
msgstr ""

#: inc/cleanup/i18n.php:32
msgid "Remove generator tag from RSS feeds."
msgstr ""

#: inc/cleanup/i18n.php:35
msgid "adjacent_posts"
msgstr ""

#: inc/cleanup/i18n.php:36
msgid "Remove the next and previous post links from the header"
msgstr ""

#: inc/cleanup/i18n.php:39
msgid "shortlink"
msgstr ""

#: inc/cleanup/i18n.php:40
msgid "Remove the shortlink url from header"
msgstr ""

#: inc/cleanup/i18n.php:43
msgid "wp_generator"
msgstr ""

#: inc/cleanup/i18n.php:44
msgid "Remove WordPress and WooCommerce meta generator tags. Used by attackers to detect the WordPress version."
msgstr ""

#: inc/cleanup/i18n.php:47
msgid "version"
msgstr ""

#: inc/cleanup/i18n.php:48
msgid "Remove WordPress version var (?ver=) after styles and scripts. Used by attackers to detect the WordPress version."
msgstr ""

#: inc/cleanup/i18n.php:51
msgid "dns-prefetch"
msgstr ""

#: inc/cleanup/i18n.php:52
msgid "Removes dns-prefetch links from the header"
msgstr ""

#: inc/cleanup/i18n.php:57
msgid "Emojicons"
msgstr ""

#: inc/cleanup/i18n.php:58
msgid "Remove lots of emoji styles and scripts from the header, RSS, mail function, tinyMCE editor..."
msgstr ""

#: inc/cleanup/i18n.php:61
msgid "PDF Thumbnails"
msgstr ""

#: inc/cleanup/i18n.php:62
msgid "Starting with 4.7, WordPress tries to make thumbnails from each PDF you upload, potentially crashing your server if GhostScript and ImageMagick aren't properly configured. This option disables PDF thumbnails."
msgstr ""

#: inc/cleanup/i18n.php:65
msgid "Limit Post Revisions"
msgstr ""

#: inc/cleanup/i18n.php:66
msgid "Limits the number of stored revisions to 5 only if WP_POST_REVISIONS constant has not been defined."
msgstr ""

#: inc/cleanup/i18n.php:69
msgid "Slow Heartbeat"
msgstr ""

#: inc/cleanup/i18n.php:70
msgid "By default, heartbeat makes a post call every 15 seconds on post edit pages. Change to 60 seconds (less CPU usage)."
msgstr ""

#: inc/cleanup/i18n.php:73
msgid "JS Comment reply"
msgstr ""

#: inc/cleanup/i18n.php:74
msgid "Load the comment-reply JS file only when needed."
msgstr ""

#: inc/cleanup/i18n.php:77
msgid "Empty trash every week"
msgstr ""

#: inc/cleanup/i18n.php:78
msgid "You can shorten the time posts are kept in the trash, which is 30 days by default, to 1 week."
msgstr ""

#: inc/cleanup/i18n.php:81
msgid "capital_P_dangit"
msgstr ""

#: inc/cleanup/i18n.php:82
msgid "Removes the filter that converts Wordpress to WordPress in every dang title, content or comment text."
msgstr ""

#: inc/cleanup/i18n.php:85
msgid "medium_large thumbnail"
msgstr ""

#: inc/cleanup/i18n.php:86
msgid "Prevents WordPress from generating the medium_large 768px thumbnail size of image uploads."
msgstr ""

#: inc/cleanup/i18n.php:89
msgid "1536x1536 thumbnail"
msgstr ""

#: inc/cleanup/i18n.php:90
msgid "Prevents WordPress from generating the 1536x1536 thumbnail size of image uploads."
msgstr ""

#: inc/cleanup/i18n.php:93
msgid "2048x2048 thumbnail"
msgstr ""

#: inc/cleanup/i18n.php:94
msgid "Prevents WordPress from generating the 2048x2048 thumbnail size of image uploads."
msgstr ""

#: inc/cleanup/i18n.php:97
msgid "No comment autolinks"
msgstr ""

#: inc/cleanup/i18n.php:98
msgid "URLs in comments are converted to links by default. This feature is often exploited by spammers."
msgstr ""

#: inc/cleanup/i18n.php:101
msgid "Random content redirect"
msgstr ""

#: inc/cleanup/i18n.php:102
msgid "Disables the /random/ URLs, added in WordPress 7.2, that redirect visitors to a random post. Each visit runs a slow random query on the database."
msgstr ""

#: inc/cleanup/i18n.php:105
msgid "Disable login languages"
msgstr ""

#: inc/cleanup/i18n.php:106
msgid "WordPress shows a language switcher at the bottom of the login screen. It's not need if you only use one language."
msgstr ""

#: inc/cleanup/i18n.php:109
msgid "Plugin and theme editor"
msgstr ""

#: inc/cleanup/i18n.php:110
msgid "Disables the plugins and theme editor. A mostly useless tool that can be very dangerous in the wrong hands."
msgstr ""

#: inc/cleanup/i18n.php:115
msgid "Core AI Support"
msgstr ""

#: inc/cleanup/i18n.php:116
msgid "Disable all WordPress core AI support features."
msgstr ""

#: inc/cleanup/i18n.php:119
msgid "JSON API"
msgstr ""

#: inc/cleanup/i18n.php:120
msgid "Remove the JSON-API links from page headers. Also require that API consumers be authenticated."
msgstr ""

#: inc/cleanup/i18n.php:120
msgid "May break plugins, headless frontends, and the block editor when not logged in. Test any integration that uses the REST API after enabling."
msgstr ""

#: inc/cleanup/i18n.php:123
msgid "XML-RPC"
msgstr ""

#: inc/cleanup/i18n.php:124
msgid "Disable the XML-RPC interface."
msgstr ""

#: inc/cleanup/i18n.php:124
msgid "May break the WordPress mobile app, Jetpack, pingbacks, and plugins that rely on XML-RPC."
msgstr ""

#: inc/cleanup/i18n.php:127
msgid "remove jQuery-migrate"
msgstr ""

#: inc/cleanup/i18n.php:128
msgid "Removes jQuery-migrate from the frontend dependency chain. It is a compatibility layer for older jQuery code."
msgstr ""

#: inc/cleanup/i18n.php:128
msgid "May break themes and plugins that rely on deprecated jQuery APIs. Test thoroughly, especially after upgrading to WordPress 7.0."
msgstr ""

#: inc/cleanup/i18n.php:131
msgid "Remove oEmbed Scripts"
msgstr ""

#: inc/cleanup/i18n.php:132
msgid "Since WordPress 4.4, oEmbed is installed and available by default. If you don't need oEmbed, you can remove it."
msgstr ""

#: inc/cleanup/i18n.php:132
msgid "May break embed blocks, auto-embedded URLs in content, and paste-to-embed in the block editor."
msgstr ""

#: inc/cleanup/i18n.php:135
msgid "Reduce JPEG quality"
msgstr ""

#: inc/cleanup/i18n.php:136
msgid "When WordPress generates a JPEG thumbnail it compresses the image to 82% quality. Check this to reduce the default quality to 72%. (It doesn't affect original image quality)."
msgstr ""

#: inc/cleanup/i18n.php:139
msgid "Disable big image scaling"
msgstr ""

#: inc/cleanup/i18n.php:140
msgid "When you upload a huge image, WordPress generates a 2560px version of it. Check this to disable this feature."
msgstr ""

#: inc/cleanup/i18n.php:143
msgid "Remove block editor CSS"
msgstr ""

#: inc/cleanup/i18n.php:144
msgid "Dequeues block editor CSS stylesheets from the frontend."
msgstr ""

#: inc/cleanup/i18n.php:144
msgid "Do not enable on sites that render blocks on the frontend. WordPress 7.0 loads block styles on demand in classic themes too; disabling them will break block layout and appearance."
msgstr ""

#: inc/cleanup/i18n.php:147
msgid "Disable Global CSS"
msgstr ""

#: inc/cleanup/i18n.php:148
msgid "Removes the inline global styles and block-support CSS that WordPress adds by default."
msgstr ""

#: inc/cleanup/i18n.php:148
msgid "Do not enable if your theme or content uses block styles, duotone, or layout support. WordPress 7.0 extends block styling to all themes; this option is likely to break site appearance."
msgstr ""

#: inc/cleanup/optimization.php:345
msgid "The REST API on this site has been disabled."
msgstr ""

