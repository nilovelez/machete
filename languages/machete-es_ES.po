msgstr "copia"

#: inc/clone/admin-functions.php:118
msgid "Clone this!"
msgstr "¡Clonar esto!"

#: inc/clone/admin-functions.php:118
msgid "Duplicate"
msgstr "Duplicar"

#: inc/clone/admin-functions.php:139 inc/clone/admin-functions.php:179
